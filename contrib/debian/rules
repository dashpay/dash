#!/usr/bin/make -f
# -*- mode: makefile; coding: utf-8 -*-

%:
	dh --with bash-completion --buildsystem=cmake --builddirectory=build $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_GUI=ON -DWITH_BDB=ON -DWITH_MINIUPNPC=ON -DWITH_ZMQ=ON

override_dh_auto_test:
	$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),,ctest --test-dir build --output-on-failure)
